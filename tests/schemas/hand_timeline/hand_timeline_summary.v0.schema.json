{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qorcap.local/schemas/hand_timeline/hand_timeline_summary.v0.schema.json",
  "title": "qorcap-hand-timeline-summary/v0 JSON",
  "description": "Stop-time summary companion hand_timeline_summary.v0.json covering both #187 and #189 fields. Skill-proof / fair-proof only; never identifies who held the controller.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "file",
    "sha256",
    "head",
    "first_seq",
    "last_seq",
    "chunks",
    "raw_usb",
    "raw_paused",
    "raw_file",
    "raw_bytes",
    "raw_record_bytes",
    "raw_layout",
    "hand_dir",
    "hand_dir_source",
    "hand_dir_fallback_reason",
    "device_models_seen",
    "fallback",
    "epochs",
    "reports",
    "in_rows",
    "frames",
    "frame_drops",
    "disk_faults",
    "frame_clock",
    "adaptive_trigger_state",
    "report_rate_hz",
    "claims"
  ],
  "properties": {
    "schema": { "const": "qorcap-hand-timeline-summary/v0" },
    "file": { "const": "hand_timeline.v0.jsonl" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "head": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "first_seq": { "type": "integer", "minimum": 0 },
    "last_seq": { "type": ["integer", "null"], "minimum": 0 },
    "chunks": { "type": "integer", "minimum": 0 },
    "raw_usb": { "type": "boolean" },
    "raw_paused": { "type": ["string", "null"] },
    "raw_file": { "oneOf": [{ "const": "hand_raw.v0.bin" }, { "type": "null" }] },
    "raw_bytes": { "type": "integer", "minimum": 0 },
    "raw_record_bytes": { "const": 80 },
    "raw_layout": { "const": "v1" },
    "hand_dir": { "type": "string" },
    "hand_dir_source": { "enum": ["default_d", "override", "fallback_bundle", "direct"] },
    "hand_dir_fallback_reason": { "type": ["string", "null"] },
    "device_models_seen": { "type": "array", "items": { "enum": ["dualsense_edge", "dualsense"] } },
    "fallback": { "type": "boolean" },
    "epochs": { "type": "integer", "minimum": 0 },
    "reports": { "type": "integer", "minimum": 0 },
    "in_rows": { "type": "integer", "minimum": 0 },
    "frames": { "type": "integer", "minimum": 0 },
    "frame_drops": { "type": "integer", "minimum": 0 },
    "disk_faults": { "type": "integer", "minimum": 0 },
    "frame_clock": { "type": "string" },
    "adaptive_trigger_state": { "const": "UNMEASURED" },
    "report_rate_hz": { "const": "UNMEASURED" },
    "claims": { "type": "string" },
    "bytes_42_43_raw_last": {
      "oneOf": [
        { "const": "UNKNOWN" },
        { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      ],
      "description": "Last observed [raw[42], raw[43]] pair ([r2_raw, l2_raw] per R2 bench match-20261122-155333), or UNKNOWN if no USB 0x01 report arrived."
    },
    "bytes_42_43_status": { "const": "ESTIMATED" },
    "bytes_42_43_changes_suppressed": { "type": "integer", "minimum": 0 },
    "declared_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "source", "edge_profile", "l2_stop", "r2_stop", "stick_curve_left", "stick_curve_right", "in_game_trigger_effect"],
      "properties": {
        "checked": { "const": false },
        "source": { "enum": ["user_declared", "none"] },
        "edge_profile": { "type": "string" },
        "l2_stop": { "type": "string" },
        "r2_stop": { "type": "string" },
        "stick_curve_left": { "type": "string" },
        "stick_curve_right": { "type": "string" },
        "in_game_trigger_effect": { "type": "string" }
      }
    }
  }
}
