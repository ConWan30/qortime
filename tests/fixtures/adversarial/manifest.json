{
  "base": "site/matches/170123/receipt.json",
  "pin": "referee.pubkey",
  "description": "Raw-text edits of the published VERIFIED receipt for match 170123. Both verifiers must return expect. error, when set, must appear in errors.",
  "cases": [
    {
      "id": "baseline",
      "expect": "VERIFIED",
      "note": "published match 170123 receipt, unmodified"
    },
    {
      "id": "odd_sig_nonhex",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "non-hex character appended to the referee signature",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00ez\"\n"
      ]
    },
    {
      "id": "float_score",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "away_score written as 10.0 instead of 10",
      "replace": [
        "    \"home_score\": 0,\n    \"away_score\": 10,\n    \"quarter\": 4,\n",
        "    \"home_score\": 0,\n    \"away_score\": 10.0,\n    \"quarter\": 4,\n"
      ]
    },
    {
      "id": "sig_extra",
      "expect": "FAIL",
      "error": "noncanonical_signatures",
      "note": "extra unsigned key under signatures",
      "replace": [
        "  \"signatures\": {\n",
        "  \"signatures\": {\n    \"note\": \"unsigned junk\",\n"
      ]
    },
    {
      "id": "uppercase_sig",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "referee signature hex uppercased",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"E4E33B7003A63647D740516A7B72ACBEDF12D43D7FDC305924C462FDD76F1B70E0768146016B5CA2CA5832FB7166640ABC6967B28D2B55F5EC6879F1D0C1A00E\"\n"
      ]
    },
    {
      "id": "odd_length_hex",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "odd-length referee signature (trailing hex nibble)",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00ea\"\n"
      ]
    },
    {
      "id": "leading_zero_hex",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "leading zero on the referee signature",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"0e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n"
      ]
    },
    {
      "id": "uppercase_pubkey",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "referee pubkey hex uppercased",
      "replace": [
        "    \"pubkey\": \"b283cffb9279f2f90859268c64ef21861ef7e5d9fc773bdb8061af0e80624889\",\n",
        "    \"pubkey\": \"B283CFFB9279F2F90859268C64EF21861EF7E5D9FC773BDB8061AF0E80624889\",\n"
      ]
    },
    {
      "id": "negative_score",
      "expect": "FAIL",
      "error": "score_not_nonneg_int",
      "note": "negative home_score",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": -1,\n"
      ]
    },
    {
      "id": "exponent_score",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "away_score written with an exponent",
      "replace": [
        "    \"away_score\": 10,\n",
        "    \"away_score\": 10e0,\n"
      ]
    },
    {
      "id": "leading_zero_number",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "leading zero on quarter",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": 04,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "negative_zero",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "home_score written as -0",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": -0,\n"
      ]
    },
    {
      "id": "duplicate_sig_key",
      "expect": "FAIL",
      "error": "noncanonical_duplicate_key",
      "note": "duplicate referee sig key, same value",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\",\n      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n"
      ]
    },
    {
      "id": "lone_surrogate_unsigned",
      "expect": "FAIL",
      "error": "noncanonical_surrogate",
      "note": "lone surrogate in an unsigned signatures member",
      "replace": [
        "  \"signatures\": {\n",
        "  \"signatures\": {\n    \"note\": \"\\uD800\",\n"
      ]
    },
    {
      "id": "extra_inside_sig",
      "expect": "FAIL",
      "error": "noncanonical_signatures",
      "note": "extra key inside the referee signature object",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\",\n      \"extra\": 1\n"
      ]
    },
    {
      "id": "extra_player_signer",
      "expect": "FAIL",
      "error": "noncanonical_signatures",
      "note": "signature for a role that is not in players[]",
      "replace": [
        "    \"players\": {\n      \"away\": {\n",
        "    \"players\": {\n      \"home\": {\"key_id\": \"e2bf530b09b98dd4\", \"sig\": \"2e12bfd92723535ca5af40e65e448f635c5800e04b9d03adfcf5a251e8f62a79b7f88d79ad018674bbbd08c3b340a60e20125f44b540f3561a2a1fecd0b70201\"},\n      \"away\": {\n"
      ]
    },
    {
      "id": "extra_signed_result_key",
      "expect": "FAIL",
      "error": "bad_referee_signature",
      "note": "extra key in the signed result object",
      "replace": [
        "    \"final_confirmed\": true\n  },\n",
        "    \"final_confirmed\": true,\n    \"not_in_schema\": 1\n  },\n"
      ]
    },
    {
      "id": "extra_top_level",
      "expect": "FAIL",
      "error": "bad_referee_signature",
      "note": "extra top-level key in the signed body",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",\n",
        "\"schema\": \"qor-receipt/v0\",\n  \"extra_top\": 1,\n"
      ]
    },
    {
      "id": "uppercase_checkpoint_hash",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "uppercase checkpoint hash",
      "replace": [
        "\"hash\": \"51f380936a84322f80b730104cf65a4f6b9cb27e4e5b4bd464aafe1422d23f31\"",
        "\"hash\": \"51F380936A84322F80B730104CF65A4F6B9CB27E4E5B4BD464AAFE1422D23F31\""
      ]
    },
    {
      "id": "nonhex_inside_sig",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "non-hex character inside the referee signature",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"g4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n"
      ]
    },
    {
      "id": "duplicate_schema_key",
      "expect": "FAIL",
      "error": "noncanonical_duplicate_key",
      "note": "duplicate schema key with the same value",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",\n",
        "\"schema\": \"qor-receipt/v0\", \"schema\": \"qor-receipt/v0\",\n"
      ]
    },
    {
      "id": "lone_surrogate_signed",
      "expect": "FAIL",
      "error": "noncanonical_surrogate",
      "note": "lone surrogate in a signed string",
      "replace": [
        "\"player_id\": \"local:player\"",
        "\"player_id\": \"local:player\\uD800\""
      ]
    },
    {
      "id": "uppercase_key_id",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "uppercase key id on the referee signature",
      "replace": [
        "      \"key_id\": \"4fc237e4c6a24cf6\",\n      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"",
        "      \"key_id\": \"4FC237E4C6A24CF6\",\n      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\""
      ]
    },
    {
      "id": "float_quarter",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "quarter written as 4.0",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": 4.0,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "float_motion",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "motion permille written as 521.0",
      "replace": [
        "\"motion_permille\": {\n      \"away\": 521\n",
        "\"motion_permille\": {\n      \"away\": 521.0\n"
      ]
    }
  ]
}
