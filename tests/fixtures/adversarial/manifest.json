{
  "base": "site/matches/170123/receipt.json",
  "pin": "referee.pubkey",
  "description": "Raw-text edits of the published VERIFIED receipt for match 170123, plus generated over-limit inputs. Both verifiers must return expect. error, when set, must appear in errors. Probe cases from the PR #69 review are the small edits here, not copies of the receipt.",
  "cases": [
    {
      "id": "baseline",
      "expect": "VERIFIED",
      "note": "published match 170123 receipt, unmodified"
    },
    {
      "id": "odd_sig_nonhex",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "non-hex character appended to the referee signature",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00ez\"\n"
      ]
    },
    {
      "id": "float_score",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "away_score written as 10.0 instead of 10",
      "replace": [
        "    \"home_score\": 0,\n    \"away_score\": 10,\n    \"quarter\": 4,\n",
        "    \"home_score\": 0,\n    \"away_score\": 10.0,\n    \"quarter\": 4,\n"
      ]
    },
    {
      "id": "sig_extra",
      "expect": "FAIL",
      "error": "noncanonical_signatures",
      "note": "extra unsigned key under signatures",
      "replace": [
        "  \"signatures\": {\n",
        "  \"signatures\": {\n    \"note\": \"unsigned junk\",\n"
      ]
    },
    {
      "id": "uppercase_sig",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "referee signature hex uppercased",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"E4E33B7003A63647D740516A7B72ACBEDF12D43D7FDC305924C462FDD76F1B70E0768146016B5CA2CA5832FB7166640ABC6967B28D2B55F5EC6879F1D0C1A00E\"\n"
      ]
    },
    {
      "id": "odd_length_hex",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "odd-length referee signature (trailing hex nibble)",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00ea\"\n"
      ]
    },
    {
      "id": "leading_zero_hex",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "leading zero on the referee signature",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"0e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n"
      ]
    },
    {
      "id": "uppercase_pubkey",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "referee pubkey hex uppercased",
      "replace": [
        "    \"pubkey\": \"b283cffb9279f2f90859268c64ef21861ef7e5d9fc773bdb8061af0e80624889\",\n",
        "    \"pubkey\": \"B283CFFB9279F2F90859268C64EF21861EF7E5D9FC773BDB8061AF0E80624889\",\n"
      ]
    },
    {
      "id": "negative_score",
      "expect": "FAIL",
      "error": "score_not_nonneg_int",
      "note": "negative home_score",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": -1,\n"
      ]
    },
    {
      "id": "exponent_score",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "away_score written with an exponent",
      "replace": [
        "    \"away_score\": 10,\n",
        "    \"away_score\": 10e0,\n"
      ]
    },
    {
      "id": "leading_zero_number",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "leading zero on quarter",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": 04,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "negative_zero",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "home_score written as -0",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": -0,\n"
      ]
    },
    {
      "id": "duplicate_sig_key",
      "expect": "FAIL",
      "error": "noncanonical_duplicate_key",
      "note": "duplicate referee sig key, same value",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\",\n      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n"
      ]
    },
    {
      "id": "lone_surrogate_unsigned",
      "expect": "FAIL",
      "error": "noncanonical_surrogate",
      "note": "lone surrogate in an unsigned signatures member",
      "replace": [
        "  \"signatures\": {\n",
        "  \"signatures\": {\n    \"note\": \"\\uD800\",\n"
      ]
    },
    {
      "id": "extra_inside_sig",
      "expect": "FAIL",
      "error": "noncanonical_signatures",
      "note": "extra key inside the referee signature object",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\",\n      \"extra\": 1\n"
      ]
    },
    {
      "id": "extra_player_signer",
      "expect": "FAIL",
      "error": "noncanonical_signatures",
      "note": "signature for a role that is not in players[]",
      "replace": [
        "    \"players\": {\n      \"away\": {\n",
        "    \"players\": {\n      \"home\": {\"key_id\": \"e2bf530b09b98dd4\", \"sig\": \"2e12bfd92723535ca5af40e65e448f635c5800e04b9d03adfcf5a251e8f62a79b7f88d79ad018674bbbd08c3b340a60e20125f44b540f3561a2a1fecd0b70201\"},\n      \"away\": {\n"
      ]
    },
    {
      "id": "extra_signed_result_key",
      "expect": "FAIL",
      "error": "bad_referee_signature",
      "note": "extra key in the signed result object",
      "replace": [
        "    \"final_confirmed\": true\n  },\n",
        "    \"final_confirmed\": true,\n    \"not_in_schema\": 1\n  },\n"
      ]
    },
    {
      "id": "extra_top_level",
      "expect": "FAIL",
      "error": "bad_referee_signature",
      "note": "extra top-level key in the signed body",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",\n",
        "\"schema\": \"qor-receipt/v0\",\n  \"extra_top\": 1,\n"
      ]
    },
    {
      "id": "uppercase_checkpoint_hash",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "uppercase checkpoint hash",
      "replace": [
        "\"hash\": \"51f380936a84322f80b730104cf65a4f6b9cb27e4e5b4bd464aafe1422d23f31\"",
        "\"hash\": \"51F380936A84322F80B730104CF65A4F6B9CB27E4E5B4BD464AAFE1422D23F31\""
      ]
    },
    {
      "id": "nonhex_inside_sig",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "non-hex character inside the referee signature",
      "replace": [
        "      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n",
        "      \"sig\": \"g4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"\n"
      ]
    },
    {
      "id": "duplicate_schema_key",
      "expect": "FAIL",
      "error": "noncanonical_duplicate_key",
      "note": "duplicate schema key with the same value",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",\n",
        "\"schema\": \"qor-receipt/v0\", \"schema\": \"qor-receipt/v0\",\n"
      ]
    },
    {
      "id": "lone_surrogate_signed",
      "expect": "FAIL",
      "error": "noncanonical_surrogate",
      "note": "lone surrogate in a signed string",
      "replace": [
        "\"player_id\": \"local:player\"",
        "\"player_id\": \"local:player\\uD800\""
      ]
    },
    {
      "id": "uppercase_key_id",
      "expect": "FAIL",
      "error": "noncanonical_hex",
      "note": "uppercase key id on the referee signature",
      "replace": [
        "      \"key_id\": \"4fc237e4c6a24cf6\",\n      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\"",
        "      \"key_id\": \"4FC237E4C6A24CF6\",\n      \"sig\": \"e4e33b7003a63647d740516a7b72acbedf12d43d7fdc305924c462fdd76f1b70e0768146016b5ca2ca5832fb7166640abc6967b28d2b55f5ec6879f1d0c1a00e\""
      ]
    },
    {
      "id": "float_quarter",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "quarter written as 4.0",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": 4.0,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "float_motion",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "motion permille written as 521.0",
      "replace": [
        "\"motion_permille\": {\n      \"away\": 521\n",
        "\"motion_permille\": {\n      \"away\": 521.0\n"
      ]
    },
    {
      "id": "proto_top_obj",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "__proto__ object at the top level is not an own member the signature covers",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\": \"qor-receipt/v0\", \"__proto__\": {},"
      ]
    },
    {
      "id": "proto_top_num",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "__proto__ number at the top level",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\": \"qor-receipt/v0\", \"__proto__\": 1,"
      ]
    },
    {
      "id": "proto_in_signatures",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "__proto__ inside signatures",
      "replace": [
        "  \"signatures\": {\n",
        "  \"signatures\": {\n    \"__proto__\": {\"note\": \"unsigned\"},\n"
      ]
    },
    {
      "id": "proto_in_result",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "__proto__ inside result",
      "replace": [
        "    \"final_confirmed\": true\n  },\n",
        "    \"final_confirmed\": true,\n    \"__proto__\": {\"winner\": \"home\"}\n  },\n"
      ]
    },
    {
      "id": "proto_dup_top",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "duplicated __proto__ member",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\": \"qor-receipt/v0\", \"__proto__\": {}, \"__proto__\": {},"
      ]
    },
    {
      "id": "proto_in_players_sig",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "__proto__ inside signatures.players",
      "replace": [
        "  \"signatures\": {\n    \"players\": {\n",
        "  \"signatures\": {\n    \"players\": {\n      \"__proto__\": {\"key_id\": \"x\", \"sig\": \"y\"},\n"
      ]
    },
    {
      "id": "constructor_key",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "constructor member",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\": \"qor-receipt/v0\", \"constructor\": 1,"
      ]
    },
    {
      "id": "prototype_key",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "prototype member",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\": \"qor-receipt/v0\", \"prototype\": 1,"
      ]
    },
    {
      "id": "arabic_indic_digit",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "Arabic-Indic digit is not an ASCII integer",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": \u0664,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "superscript_digit",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "superscript digit must not raise or verify",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": \u00b2,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "fullwidth_digit",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "fullwidth digit is not an ASCII integer",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": \uff14,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "neg_arabic_zero",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "Arabic-Indic negative zero is not canonical -0",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": -\u0660,\n"
      ]
    },
    {
      "id": "mixed_ascii_arabic_digit",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "ASCII zero followed by an Arabic-Indic digit",
      "replace": [
        "    \"quarter\": 4,\n    \"final_t_ms\":",
        "    \"quarter\": 0\u0664,\n    \"final_t_ms\":"
      ]
    },
    {
      "id": "bom",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "leading U+FEFF",
      "prefix": "\ufeff"
    },
    {
      "id": "trailing_ws",
      "expect": "VERIFIED",
      "note": "trailing whitespace is still the same receipt",
      "suffix": "\n \t\r\n"
    },
    {
      "id": "trailing_garbage",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "trailing non-json",
      "suffix": "x"
    },
    {
      "id": "trailing_nul",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "trailing NUL",
      "suffix": "\u0000"
    },
    {
      "id": "second_doc",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "a second JSON value",
      "suffix": "{}"
    },
    {
      "id": "exponent_1e21",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "1e21",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": 1e21,\n"
      ]
    },
    {
      "id": "exponent_5e_324",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "5e-324",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": 5e-324,\n"
      ]
    },
    {
      "id": "neg_zero_float",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "-0.0",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": -0.0,\n"
      ]
    },
    {
      "id": "above_max_safe",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "2^53",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": 9007199254740992,\n"
      ]
    },
    {
      "id": "max_safe_integer",
      "expect": "FAIL",
      "error": "bad_referee_signature",
      "note": "2^53-1 is a canonical integer but it is not the signed score",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": 9007199254740991,\n"
      ]
    },
    {
      "id": "huge_integer",
      "expect": "FAIL",
      "error": "noncanonical_number",
      "note": "400-digit integer",
      "replace": [
        "    \"home_score\": 0,\n",
        "    \"home_score\": ,\n"
      ]
    },
    {
      "id": "escaped_dup_key",
      "expect": "FAIL",
      "error": "noncanonical_duplicate_key",
      "note": "schema repeated via a unicode escape",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\": \"qor-receipt/v0\", \"schem\\u0061\": \"qor-receipt/v0\","
      ]
    },
    {
      "id": "nested_dup_result",
      "expect": "FAIL",
      "error": "noncanonical_duplicate_key",
      "note": "duplicate key inside result",
      "replace": [
        "    \"final_confirmed\": true\n  },\n",
        "    \"final_confirmed\": true,\n    \"final_confirmed\": true\n  },\n"
      ]
    },
    {
      "id": "nbsp_whitespace",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "NBSP is not JSON whitespace",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\":\u00a0\"qor-receipt/v0\","
      ]
    },
    {
      "id": "vertical_tab_whitespace",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "vertical tab is not JSON whitespace",
      "replace": [
        "\"schema\": \"qor-receipt/v0\",",
        "\"schema\":\u000b\"qor-receipt/v0\","
      ]
    },
    {
      "id": "raw_control_in_string",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "raw control character in a string",
      "replace": [
        "\"player_id\": \"local:player\"",
        "\"player_id\": \"local:play\u0001er\""
      ]
    },
    {
      "id": "unicode_escape_same_value",
      "expect": "VERIFIED",
      "note": "a unicode escape that decodes to the same signed string",
      "replace": [
        "\"player_id\": \"local:player\"",
        "\"player_id\": \"local:pl\\u0061yer\""
      ]
    },
    {
      "id": "over_depth",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "one level past the spec depth cap",
      "generate": "depth"
    },
    {
      "id": "over_size",
      "expect": "FAIL",
      "error": "noncanonical_json",
      "note": "one byte past the spec size cap",
      "generate": "size"
    }
  ]
}
